---
import GuideLayout from "../../layouts/GuideLayout.astro";
import guide from "../../data/guide.json";
import { formatN } from "../../lib/format.mjs";
import { withBase } from "../../lib/paths.mjs";

export function getStaticPaths() {
  return ["3", "11", "14", "17", "23"].map((age) => ({ params: { age } }));
}

const { age } = Astro.params;
const variables = (guide.variables as {
  name: string;
  age: string | null;
  domain: string;
  domainLabel: string;
  question: string;
  yesN: number | null;
  href: string;
}[]).filter((variable) => variable.age === age);

const byDomain = new Map<string, typeof variables>();
for (const variable of variables) {
  const list = byDomain.get(variable.domainLabel) ?? [];
  list.push(variable);
  byDomain.set(variable.domainLabel, list);
}

const respKey = age ? `resp${age}` : "";
const respN = (guide.meta.respondents as Record<string, number>)[respKey];
---

<GuideLayout title={`Age ${age}`} eyebrow="By age">
  <h1>Age {age}</h1>
  <p class="lede">
    Every class-file variable attached to age {age}.
    {respN
      ? ` The interview flag has ${formatN(respN)} respondents.`
      : " Age 3 items come from the sweep-2 parent interview and the core file."}
  </p>
  {
    [...byDomain.entries()].map(([domain, rows]) => (
      <section>
        <h2>{domain}</h2>
        {rows.map((variable) => (
          <a class="var-row" href={withBase(variable.href)}>
            <span class="name">
              <code>{variable.name}</code>
            </span>
            <span class="age" />
            <span class="q">{variable.question}</span>
            <span class="yes">{variable.yesN != null ? `Yes ${formatN(variable.yesN)}` : ""}</span>
          </a>
        ))}
      </section>
    ))
  }
</GuideLayout>
