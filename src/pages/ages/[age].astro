---
import GuideLayout from "../../layouts/GuideLayout.astro";
import guide from "../../data/guide.json";
import { AGE_STOPS, findAgeStop, variableMatchesStop } from "../../lib/ages.mjs";
import { formatN } from "../../lib/format.mjs";
import { withBase } from "../../lib/paths.mjs";

export function getStaticPaths() {
  return AGE_STOPS.map((stop) => ({ params: { age: stop.key } }));
}

const { age } = Astro.params;
const stop = findAgeStop(age ?? "");
if (!stop) throw new Error(`Unknown age stop: ${age}`);

const variables = (guide.variables as {
  name: string;
  age: string | null;
  domain: string;
  domainLabel: string;
  question: string;
  yesN: number | null;
  href: string;
}[]).filter((variable) => variableMatchesStop(variable.age, stop));

const byDomain = new Map<string, typeof variables>();
for (const variable of variables) {
  const list = byDomain.get(variable.domainLabel) ?? [];
  list.push(variable);
  byDomain.set(variable.domainLabel, list);
}

const countN = (guide.meta.respondents as Record<string, number>)[stop.countKey];
---

<GuideLayout title={stop.label} eyebrow="By age">
  <h1>{stop.label}</h1>
  <p class="lede">
    {stop.lede}
    {countN ? ` ${formatN(countN)} cohort members have the items used here.` : ""}
  </p>
  {
    byDomain.size === 0 ? (
      <p>No class-file variables are tagged to this sweep.</p>
    ) : (
      [...byDomain.entries()].map(([domain, rows]) => (
        <section>
          <h2>{domain}</h2>
          {rows.map((variable) => (
            <a class="var-row" href={withBase(variable.href)}>
              <span class="name">
                <code>{variable.name}</code>
              </span>
              <span class="age" />
              <span class="q">{variable.question}</span>
              <span class="yes">{variable.yesN != null ? `Yes ${formatN(variable.yesN)}` : ""}</span>
            </a>
          ))}
        </section>
      ))
    )
  }
</GuideLayout>
