---
import GuideLayout from "../layouts/GuideLayout.astro";
import guide from "../data/guide.json";

const chapter = guide.chapters.find((item) => item.href === "/introduction");
if (!chapter) throw new Error("Introduction chapter missing from ingest");
---

<GuideLayout title="Introduction" eyebrow="Section 1">
  <h1>Introduction</h1>
  <div class="prose" set:html={chapter.html} />
  {
    chapter.subsections.map((section) => (
      <section>
        <h2 id={section.slug}>{section.heading}</h2>
        <div class="prose" set:html={section.html} />
      </section>
    ))
  }
</GuideLayout>
