---
interface Props {
  name: "book" | "person" | "pen" | "scale" | "timeline" | "search";
  label?: string;
}

const { name, label } = Astro.props;

const paths: Record<Props["name"], string> = {
  book: `<path d="M5 5.5h6.2c1.4 0 2.3.8 2.3 2.1V19c0-1.2-.9-2-2.3-2H5V5.5Z"/><path d="M19 5.5h-6.2c-1.4 0-2.3.8-2.3 2.1V19c0-1.2.9-2 2.3-2H19V5.5Z"/>`,
  person: `<circle cx="12" cy="8" r="3.2"/><path d="M5.2 18.5c.8-3 3.2-4.6 6.8-4.6s6 1.6 6.8 4.6"/>`,
  pen: `<path d="M14.2 5.2 18.8 9.8 9 19.6H4.4V15Z"/><path d="m12.6 6.8 4.6 4.6"/>`,
  scale: `<path d="M12 4v15M6 19h12"/><path d="M12 7h6.2L16 12.2a3.2 3.2 0 1 1-6.4 0L12 7Z"/><path d="M12 7H5.8L8 12.2a3.2 3.2 0 1 0 6.4 0L12 7Z"/>`,
  timeline: `<path d="M4 12h16"/><circle cx="6" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="18" cy="12" r="1.7"/>`,
  search: `<circle cx="11" cy="11" r="5.5"/><path d="m15.8 15.8 4 4"/>`,
};
---

<span class="icon" aria-hidden={label ? undefined : "true"} aria-label={label}>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={paths[name]} />
</span>
